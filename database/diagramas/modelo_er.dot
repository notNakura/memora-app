digraph ER {
graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=1.3, fontname="DejaVu Sans", bgcolor="white", pad=0.4];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [color="#1E2A5A", penwidth=1.3, arrowsize=0.9];
institution [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>INSTITUTION</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>institution_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(120) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">type</td><td align="left"><font color="#4A5370">VARCHAR(12) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">join_code</td><td align="left"><font color="#4A5370">CHAR(8) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">code_expires_at</td><td align="left"><font color="#4A5370">TIMESTAMP</font></td></tr><tr><td align="left" width="18"> </td><td align="left">join_mode</td><td align="left"><font color="#4A5370">VARCHAR(8) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">status</td><td align="left"><font color="#4A5370">VARCHAR(10) NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">created_by</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">created_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr></table>>];
area [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>AREA</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>area_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">institution_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(100) NN</font></td></tr></table>>];
membership [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>MEMBERSHIP</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>membership_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">user_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">institution_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">area_id</td><td align="left"><font color="#4A5370">INT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">role</td><td align="left"><font color="#4A5370">VARCHAR(18) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">status</td><td align="left"><font color="#4A5370">VARCHAR(10) NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">approved_by</td><td align="left"><font color="#4A5370">INT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">created_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr></table>>];
app_user [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>APP_USER</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">national_id</td><td align="left"><font color="#4A5370">VARCHAR(12)</font></td></tr><tr><td align="left" width="18"> </td><td align="left">first_names</td><td align="left"><font color="#4A5370">VARCHAR(60)</font></td></tr><tr><td align="left" width="18"> </td><td align="left">last_names</td><td align="left"><font color="#4A5370">VARCHAR(60)</font></td></tr><tr><td align="left" width="18"> </td><td align="left">email</td><td align="left"><font color="#4A5370">VARCHAR(120) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">email_verified_at</td><td align="left"><font color="#4A5370">TIMESTAMP</font></td></tr><tr><td align="left" width="18"> </td><td align="left">password_hash</td><td align="left"><font color="#4A5370">VARCHAR(255)</font></td></tr><tr><td align="left" width="18"> </td><td align="left">birth_date</td><td align="left"><font color="#4A5370">DATE</font></td></tr><tr><td align="left" width="18"> </td><td align="left">sex</td><td align="left"><font color="#4A5370">VARCHAR(12)</font></td></tr><tr><td align="left" width="18"> </td><td align="left">desired_retention</td><td align="left"><font color="#4A5370">NUMERIC(3,2) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">time_factor</td><td align="left"><font color="#4A5370">NUMERIC(3,2) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">daily_new_limit</td><td align="left"><font color="#4A5370">SMALLINT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">notifications_enabled</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">vibration_enabled</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">reminder_time</td><td align="left"><font color="#4A5370">TIME NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">show_name_publicly</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">onboarding_completed</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">is_platform_admin</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">is_active</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">created_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr></table>>];
email_code [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>EMAIL_CODE</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>code_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">user_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">purpose</td><td align="left"><font color="#4A5370">VARCHAR(16) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">code_hash</td><td align="left"><font color="#4A5370">VARCHAR(255) NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">requested_by</td><td align="left"><font color="#4A5370">INT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">attempts</td><td align="left"><font color="#4A5370">SMALLINT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">created_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">expires_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">used_at</td><td align="left"><font color="#4A5370">TIMESTAMP</font></td></tr></table>>];
academic_term [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>ACADEMIC_TERM</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>term_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">institution_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(10) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">starts_on</td><td align="left"><font color="#4A5370">DATE NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">ends_on</td><td align="left"><font color="#4A5370">DATE NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">status</td><td align="left"><font color="#4A5370">VARCHAR(8) NN</font></td></tr></table>>];
subject [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>SUBJECT</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>subject_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">area_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">code</td><td align="left"><font color="#4A5370">VARCHAR(15) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(100) NN</font></td></tr></table>>];
unit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>UNIT</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>unit_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">subject_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">number</td><td align="left"><font color="#4A5370">SMALLINT NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(100) NN</font></td></tr></table>>];
section [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#1E2A5A"><tr><td colspan="3" bgcolor="#1E2A5A"><font color="white"><b>SECTION</b></font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>PK</b></font></td><td align="left"><b>section_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">subject_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">term_id</td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#1E2A5A"><b>FK</b></font></td><td align="left">teacher_id</td><td align="left"><font color="#4A5370">INT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">name</td><td align="left"><font color="#4A5370">VARCHAR(20) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">join_code</td><td align="left"><font color="#4A5370">CHAR(6) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">code_expires_at</td><td align="left"><font color="#4A5370">TIMESTAMP</font></td></tr><tr><td align="left" width="18"> </td><td align="left">join_mode</td><td align="left"><font color="#4A5370">VARCHAR(8) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">capacity</td><td align="left"><font color="#4A5370">SMALLINT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">is_archived</td><td align="left"><font color="#4A5370">BOOLEAN NN</font></td></tr></table>>];
