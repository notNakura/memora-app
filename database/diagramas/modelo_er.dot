deck_endorsement [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0E7C6A"><tr><td colspan="3" bgcolor="#0E7C6A"><font color="white"><b>DECK_ENDORSEMENT</b></font></td></tr><tr><td align="left" width="18"><font color="#0E7C6A"><b>PK FK</b></font></td><td align="left"><b>deck_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#0E7C6A"><b>PK FK</b></font></td><td align="left"><b>section_id</b></td><td align="left"><font color="#4A5370">INT NN</font></td></tr><tr><td align="left" width="18"><font color="#0E7C6A"><b>FK</b></font></td><td align="left">teacher_id</td><td align="left"><font color="#4A5370">INT</font></td></tr><tr><td align="left" width="18"> </td><td align="left">status</td><td align="left"><font color="#4A5370">VARCHAR(10) NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">requested_at</td><td align="left"><font color="#4A5370">TIMESTAMP NN</font></td></tr><tr><td align="left" width="18"> </td><td align="left">reviewed_at</td><td align="left"><font color="#4A5370">TIMESTAMP</font></td></tr><tr><td align="left" width="18"> </td><td align="left">comment</td><td align="left"><font color="#4A5370">VARCHAR(300)</font></td></tr></table>>];
